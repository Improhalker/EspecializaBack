APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=your-project-ref.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require
# No pooler transacional (porta 6543), use consultas preparadas emuladas.
DB_EMULATE_PREPARES=false
# Útil no servidor local de processo único; mantenha desativado por padrão.
DB_PERSISTENT=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=COLE_O_KEY_ID
AWS_SECRET_ACCESS_KEY=COLE_O_SECRET
AWS_DEFAULT_REGION=COLE_A_REGION_MOSTRADA_NO_SUPABASE
AWS_BUCKET=EspecializaCondutor
AWS_ENDPOINT=COLE_O_ENDPOINT_MOSTRADO_NO_SUPABASE
AWS_USE_PATH_STYLE_ENDPOINT=true

VITE_APP_NAME="${APP_NAME}"

# Biblioteca de mídia: credenciais exclusivas do servidor Laravel.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Alternativa legada: SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=media
MEDIA_MAX_UPLOAD_KB=10240
MEDIA_MAX_SVG_KB=512
MEDIA_MAX_DIMENSION=2400
MEDIA_MAX_PIXELS=24000000
MEDIA_WEBP_QUALITY=82
MEDIA_CACHE_SECONDS=300

# SEO: habilitar apenas no domínio HTTPS público servido pelo Laravel.
SITE_URL=
SITE_INDEXABLE=false
# FRONTEND_BUILD_PATH= (padrão: ../especializaCondutor2026/dist)
